# .env file for Plex Portal
# Copy this file to .env and modify the values as needed

# Application Settings
SECRET_KEY=change_this_to_a_random_string_in_production
PORT=5000
DEBUG=False

# Plex Integration
PLEX_SERVER_URL=http://your-plex-server:32400
PLEX_TOKEN=your_plex_token

# Overseerr Integration
OVERSEERR_URL=http://your-overseerr-server:5055
OVERSEERR_API_KEY=your_overseerr_api_key

# Database Settings
DB_HOST=db
DB_PORT=3306
DB_USERNAME=plex_portal
DB_PASSWORD=change_this_in_production
DB_NAME=plex_portal_db
MYSQL_ROOT_PASSWORD=change_this_in_production

# Docker Image Settings
IMAGE_NAME=plex-portal:latest
